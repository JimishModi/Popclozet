# apps/customer-app/.env.example
# Copy to .env and fill in values. Never commit the real .env.
#
# CRITICAL: every variable here ends up in the production JS bundle.
# Anything that must stay secret (Razorpay key_secret, MSG91 auth key, Mappls REST key)
# MUST live in Supabase Edge Function env vars, NOT here.

# Supabase (anon key is safe in bundle IF Row Level Security is enforced on every table)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Razorpay — publishable key only (rzp_live_... or rzp_test_...).
# RAZORPAY_KEY_SECRET lives in Supabase Edge Function env, never here.
VITE_RAZORPAY_KEY_ID=

# Mappls REST key — used by @popclozet/map-core to initialize the Mappls Web Maps SDK.
# This ships in client JS. RESTRICT it to popclozet.in domains in the Mappls dashboard
# (Console → API Keys → Domain restrictions).
VITE_MAPPLS_REST_KEY=

# Web Push (VAPID public key — designed to be public)
VITE_VAPID_PUBLIC_KEY=

# MSG91 OTP widget (TODO: migrate to fully server-side flow — see plan Phase B)
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=

# App identity
VITE_APP_NAME=PopClozet
VITE_APP_URL=https://www.popclozet.in

# Feature flags
VITE_ENABLE_MAP=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_CART_RESERVATION_MINUTES=15
