# Copy to .env.local for local development overrides.
# .env.local takes precedence over .env in Vite.

VITE_APP_URL=http://localhost:3000

# Optional: point to a Supabase staging project for dev
# VITE_SUPABASE_URL=https://your-staging.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Optional: use Razorpay test mode in dev
# VITE_RAZORPAY_KEY_ID=rzp_test_...
