{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@popclozet/ui": [
        "packages/ui/src/index.tsx"
      ],
      "@popclozet/map-core": [
        "packages/map-core/src/index.ts"
      ],
      "@popclozet/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@popclozet/auth": [
        "packages/auth/src/index.tsx"
      ],
      "@popclozet/domain-contracts": [
        "packages/domain-contracts/src/index.ts"
      ]
    }
  }
}