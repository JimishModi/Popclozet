{
  "name": "popclozet-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "dev:rider": "pnpm --filter @popclozet/rider-app dev",
    "dev:customer": "pnpm --filter @popclozet/customer-app dev",
    "dev:api": "pnpm --filter @popclozet/api dev",
    "build:rider": "pnpm --filter @popclozet/rider-app build",
    "build:customer": "pnpm --filter @popclozet/customer-app build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.19.10",
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25",
    "dotenv": "^17.3.1",
    "husky": "^9.1.7",
    "mime-types": "^3.0.2",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.97.0",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^10.18.0",
    "fs-extra": "^11.3.3",
    "lucide-react": "^0.563.0",
    "mappls-web-maps": "^3.8.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@supabase/supabase-js": "2.97.0",
      "@supabase/realtime-js": "2.97.0"
    }
  }
}
